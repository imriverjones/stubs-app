{
  "expo": {
    "name": "Stash",
    "slug": "stubs",
    "scheme": "stubs",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.imriverjones.stubs",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.imriverjones.stubs",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#EDEDE9"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.imriverjones.stubs",
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 5,
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/*",
              "text/plain"
            ],
            "multipleShareMimeTypes": [
              "image/*"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5A1F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stash uses your photos so you can add ticket screenshots, and to spot new screenshots that contain a ticket code. Nothing leaves your phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Stash uses your photos so you can add ticket screenshots, and to spot new screenshots that contain a ticket code. Nothing leaves your phone.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.imriverjones.stubs.widgets",
          "groupIdentifier": "group.com.imriverjones.stubs",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "NextTicket",
              "displayName": "Next ticket",
              "description": "Your next ticket and how long to go.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Stash uses motion so holographic tickets shimmer as you tilt your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5dd43598-b43c-40bb-9dbb-4e119738bc04"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5dd43598-b43c-40bb-9dbb-4e119738bc04",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
